FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src
COPY packages/fairness-engine/package.json packages/fairness-engine/tsconfig.json ./packages/fairness-engine/
COPY packages/fairness-engine/src ./packages/fairness-engine/src
COPY packages/api-gateway/package.json packages/api-gateway/tsconfig.json ./packages/api-gateway/
COPY packages/api-gateway/src ./packages/api-gateway/src

RUN npm install
RUN npm run build

FROM node:20-alpine

WORKDIR /app

COPY package.json ./
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/fairness-engine/dist ./packages/fairness-engine/dist
COPY --from=builder /app/packages/fairness-engine/package.json ./packages/fairness-engine/
COPY --from=builder /app/packages/api-gateway/dist ./packages/api-gateway/dist
COPY --from=builder /app/packages/api-gateway/package.json ./packages/api-gateway/

RUN npm install --only=production

EXPOSE 3000

CMD ["node", "packages/api-gateway/dist/app.js"]
